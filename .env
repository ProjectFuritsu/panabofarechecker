# Fare matrix shown on the site: fares.json encoded as a token with a SHA-256 hash.
# Do not edit it by hand (the hash check will reject it). Edit fares.json, then run:
#   npm run token
# This value is public: it is built into the site's JavaScript.
VITE_FARE_.XCHap5IImrNBpx9zs3yFJ86G-2KQd2RARtE0lbFeuiU

# Optional: road-distance service for the map (any OSRM-compatible /route/v1/driving URL).
# Defaults to the free public OSRM demo server, which is fine for testing but has no uptime guarantee.
# VITE_ROUTING_URL=https://router.project-osrm.org/route/v1/driving
