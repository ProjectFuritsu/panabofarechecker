# Settings for the fare checker. `npm run token` creates .env for you; this file
# just lists what goes in it. .env is not committed: on Vercel, set these in
# Project → Settings → Environment Variables instead.

# Fare matrix shown on the site: fares.json encoded as a token with a SHA-256 hash.
# Generated by `npm run token`. Do not edit by hand (the hash check will reject it).
VITE_FARE_TOKEN=

# Optional: road-distance service for the map (any OSRM-compatible /route/v1/driving URL).
# Defaults to the free public OSRM demo server, which has no uptime guarantee.
# VITE_ROUTING_URL=https://router.project-osrm.org/route/v1/driving
